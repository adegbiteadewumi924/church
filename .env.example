# Stripe test-mode secret key. Keep real keys out of the browser and git.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Required admin credentials. Change both before exposing the app publicly.
ADMIN_USERNAME=replace_with_a_unique_username
ADMIN_PASSWORD=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_at_least_32_random_characters

# Public origin used in Stripe return URLs.
APP_BASE_URL=http://localhost:5173
PORT=4242
NODE_ENV=development
